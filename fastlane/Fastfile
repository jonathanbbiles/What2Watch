# Moodie — App Store submission without the browser.
#
# WHY THIS EXISTS
# App Store Connect's web UI kept logging us out mid-submission, so the release is driven
# from CI instead. Codemagic builds + signs + uploads the IPA (see codemagic.yaml); this
# lane then pushes the store listing and pulls the trigger on "Submit for review".
#
# SECRETS
# Authentication uses the App Store Connect API key that already lives in Codemagic as the
# integration named "ChordLoopAPIKey". Declaring `integrations: app_store_connect:` in
# codemagic.yaml makes Codemagic export it into the build as three variables, which is the
# ONLY place this lane reads it from:
#   APP_STORE_CONNECT_KEY_IDENTIFIER   APP_STORE_CONNECT_ISSUER_ID   APP_STORE_CONNECT_PRIVATE_KEY
# No key, .p8, or issuer id is written to this repo. Do not add one.

default_platform(:ios)

# Fail loudly and *by name only* if Codemagic did not inject a credential — never echo a value.
def env_or_die(name)
  value = ENV[name]
  if value.nil? || value.strip.empty?
    UI.user_error!(
      "#{name} is not set in this build. That variable comes from the Codemagic " \
      "App Store Connect integration — check that codemagic.yaml still declares " \
      "`integrations: app_store_connect: ChordLoopAPIKey` and that the key exists in " \
      "the Codemagic team settings. Do NOT hardcode the key here."
    )
  end
  value
end

platform :ios do
  desc "Upload metadata + screenshots to the editable App Store version and submit it for review"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id:                env_or_die("APP_STORE_CONNECT_KEY_IDENTIFIER"),
      issuer_id:             env_or_die("APP_STORE_CONNECT_ISSUER_ID"),
      key_content:           env_or_die("APP_STORE_CONNECT_PRIVATE_KEY"),
      is_key_content_base64: false,
      in_house:              false
    )

    deliver(
      api_key:        api_key,
      app_identifier: "com.jonathanbiles.moodie",
      platform:       "ios",

      # No `app_version:` on purpose. Left unset, deliver targets whichever version is
      # currently editable in App Store Connect — which is the rejected version, named
      # literally "1.0" — instead of us naming a version here and accidentally creating a
      # second one. The build must be stamped to match: codemagic.yaml sets
      # MARKETING_VERSION="1.0" for exactly that reason. Keep the two in step.

      # Codemagic's publishing step already uploaded the signed IPA (submit_to_testflight),
      # so there is no binary for deliver to push. deliver still picks that build up and
      # attaches it to the version during submission, waiting for Apple to finish processing.
      skip_binary_upload: true,
      skip_metadata:      false,
      skip_screenshots:   false,

      metadata_path:         "./fastlane/metadata",
      screenshots_path:      "./fastlane/screenshots",
      # The rejected version still carries the old screenshots; replace them outright.
      overwrite_screenshots: true,

      submit_for_review: true,
      # Ship on Jonathan's say-so, not the instant Apple approves.
      automatic_release: false,

      # Non-interactive: no HTML preview, no "does this look right? (y/n)" on a CI machine
      # with no terminal attached.
      force: true,

      # precheck is a linter, not a gate, and its in-app-purchase probe is a known source of
      # false failures under API-key auth. The 2.3 rejection cause (advertising Moodie+ with
      # no IAP present) was already fixed in the build and on the marketing page.
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false,

      # The compliance answers Apple asks at submission time. These match the shipped build:
      # no encryption beyond exempt HTTPS (Info.plist sets ITSAppUsesNonExemptEncryption
      # false), no third-party content, and no ad identifier — Moodie has no ads or analytics.
      submission_information: {
        export_compliance_uses_encryption:           false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa:                       false
      }
    )
  end
end
